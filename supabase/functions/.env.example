# =============================================================================
# Environment variables for the send-sms Edge Function.
#
# Copy to `.env` in this same folder for local testing:
#     cp supabase/functions/.env.example supabase/functions/.env
#
# NEVER commit the filled-in file. `.env` is already in .gitignore at the repo
# root; keep it that way. In production these are set with
# `supabase secrets set` instead -- see DEPLOY_SMS_HOOK.md.
#
# Names only below. Do not paste real values into this file.
# =============================================================================

# Generated by Supabase when you enable the Send SMS Hook.
# Dashboard -> Authentication -> Hooks -> Send SMS Hook.
# Looks like: v1,whsec_XXXXXXXXXXXXXXXXXXXXXXXX
# index.ts strips the "v1,whsec_" prefix itself, so paste it exactly as shown.
SEND_SMS_HOOK_SECRETS=

# BulkSMSBD -> your account -> API key.
BULKSMSBD_API_KEY=

# The approved sender ID / masking name on your BulkSMSBD account.
# If it is a masking ID, the OTP message must contain Bengali text or
# BulkSMSBD rejects it with code 1012. The message in index.ts already does.
BULKSMSBD_SENDER_ID=

# =============================================================================
# bKash PGW Tokenized Checkout v2 -- used by bkash-payment and bkash-callback.
# Merchant credentials: bKash gives you a sandbox set first, then a live set
# once you pass their integration review. See DEPLOY_BKASH.md.
# =============================================================================

# Sandbox:    https://tokenized.sandbox.bka.sh/v2
# Production: https://tokenized.pay.bka.sh/v2
# No trailing slash needed -- the client strips one if you leave it on.
BKASH_BASE_URL=

# From the merchant credential sheet bKash sends you.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Where the customer is sent after paying, e.g. https://shahedin.com
# No trailing slash. The callback function appends /payment-status.html to it,
# so a wrong value here strands paying customers on a 404.
SITE_URL=
